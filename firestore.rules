rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil e pontuação: só o dono lê e escreve.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Placas resolvidas: só o dono lê e escreve.
      match /solved/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ranking: qualquer usuário logado lê; cada um só altera a própria linha.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
